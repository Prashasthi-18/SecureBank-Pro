# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value
# Set true when served over HTTPS (adds Secure cookie flag + HSTS)
COOKIE_SECURE=false
# Set true only when running behind one trusted reverse proxy (Render, nginx); never when exposed directly
BEHIND_PROXY=false
SESSION_MINUTES=15
IDLE_TIMEOUT_SECONDS=600
# Optional: seeds an admin account on first start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Ch@nge-This-Admin-Pass1
